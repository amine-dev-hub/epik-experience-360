# EPIK EXPERIENCE 360 — modèle de configuration
# Copiez ce fichier en ".env.local" (local) et renseignez les mêmes variables dans Vercel.
# NE METTEZ JAMAIS DE VRAIE CLÉ DANS CE FICHIER : il est versionné sur GitHub.

# URL du projet Supabase — Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique — Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
# Exposée au navigateur : protégée par les politiques RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Clé secrète — Supabase > Project Settings > API Keys > Secret keys (sb_secret_...)
# SERVEUR UNIQUEMENT. Contourne RLS : ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Adresse publique du site, utilisée dans les QR codes (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chaîne aléatoire (48+ caractères) pour anonymiser les IP utilisées par l'anti-abus
IP_HASH_SALT=remplacez-par-une-longue-chaine-aleatoire
